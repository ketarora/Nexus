rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Incidents ───────────────────────────────────────────
    // Anyone can create (guest SOS, no login required)
    // Only authenticated users can read/update
    match /incidents/{incidentId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ─── Staff ───────────────────────────────────────────────
    // Staff can only read/write their own document
    // Managers can read all staff (role: manager in custom claims)
    match /staff/{staffId} {
      allow read: if request.auth != null && (
        request.auth.uid == staffId ||
        request.auth.token.role == 'manager'
      );
      allow write: if request.auth != null && (
        request.auth.uid == staffId ||
        request.auth.token.role == 'manager'
      );
    }

    // ─── Hotels ──────────────────────────────────────────────
    // Authenticated users can read hotel data
    // Only managers can write hotel config
    match /hotels/{hotelId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'manager';
    }

    // ─── Predictions (Sentinel) ──────────────────────────────
    match /predictions/{hotelId}/forecasts/{predId} {
      allow read: if request.auth != null;
      allow write: if false; // Written by Cloud Functions only
    }

    // ─── Replay Reports ──────────────────────────────────────
    match /replay_reports/{reportId} {
      allow read: if request.auth != null && request.auth.token.role == 'manager';
      allow write: if false; // Written by Cloud Functions only
    }
  }
}
